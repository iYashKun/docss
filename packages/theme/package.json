{
  "name": "docss-theme",
  "version": "0.1.0",
  "description": "A reusable Next.js and Fumadocs theme for MDX documentation sites.",
  "repository": {
    "type": "git",
    "url": "https://github.com/iYashKun/docss.git",
    "directory": "packages/theme"
  },
  "engines": {
    "node": ">=20.9"
  },
  "type": "module",
  "files": [
    "dist",
    "styles.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./next": {
      "types": "./dist/next.d.ts",
      "import": "./dist/next.js",
      "default": "./dist/next.js"
    },
    "./source-config": {
      "types": "./dist/source-config.d.ts",
      "import": "./dist/source-config.js",
      "default": "./dist/source-config.js"
    },
    "./styles.css": "./styles.css"
  },
  "peerDependencies": {
    "fumadocs-core": "^16.0.0",
    "fumadocs-mdx": "^15.0.0",
    "fumadocs-ui": "^16.0.0",
    "next": "^15.3.0 || ^16.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepack": "npm run build"
  }
}